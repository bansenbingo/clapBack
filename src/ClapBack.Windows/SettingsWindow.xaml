<Window x:Class="ClapBack.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClapBack 设置"
        Width="620"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">识别模式</TextBlock>
        <ComboBox x:Name="TranscriptionModeComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">本地运行时路径</TextBlock>
        <TextBox x:Name="LocalRuntimeTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">本地模型路径</TextBlock>
        <TextBox x:Name="LocalModelTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">VAD 模型路径</TextBlock>
        <TextBox x:Name="LocalVadModelTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">模型 SHA-256（可选）</TextBlock>
        <TextBox x:Name="LocalSha256TextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">本地推理后端</TextBlock>
        <ComboBox x:Name="LocalBackendComboBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,12">
            <ComboBoxItem Content="CPU" Tag="cpu" />
            <ComboBoxItem Content="Vulkan" Tag="vulkan" />
            <ComboBoxItem Content="CUDA" Tag="cuda" />
        </ComboBox>
        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">本地线程数</TextBlock>
        <TextBox x:Name="LocalThreadsTextBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">本地超时（秒）</TextBlock>
        <TextBox x:Name="LocalTimeoutTextBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,12" />

        <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">云端服务 URL</TextBlock>
        <TextBox x:Name="BaseUrlTextBox" Grid.Row="8" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">云端协议</TextBlock>
        <TextBox x:Name="CloudProtocolTextBox" Grid.Row="9" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">云端模型</TextBlock>
        <TextBox x:Name="ModelTextBox" Grid.Row="10" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="11" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">云端 API Key</TextBlock>
        <PasswordBox x:Name="ApiKeyBox" Grid.Row="11" Grid.Column="1" Margin="0,0,0,12" />

        <StackPanel Grid.Row="12" Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">本地模型</TextBlock>
                <ComboBox x:Name="LocalModelVariantComboBox" Grid.Column="1" Margin="0,0,0,12">
                    <ComboBoxItem Content="SenseVoiceSmall Q8" Tag="SenseVoiceSmall" />
                    <ComboBoxItem Content="Fun-ASR-Nano-2512 Q8" Tag="FunAsrNano2512" />
                    <ComboBoxItem Content="Paraformer 中文 Q8" Tag="ParaformerZh" />
                </ComboBox>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">语言</TextBlock>
                <TextBox x:Name="LanguageTextBox" Grid.Column="1" Margin="0,0,0,12" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">最长录音（秒）</TextBlock>
                <TextBox x:Name="MaxSecondsTextBox" Grid.Column="1" Margin="0,0,0,12" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">全局热键</TextBlock>
                <TextBox x:Name="HotkeyTextBox" Grid.Column="1" Margin="0,0,0,12" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">麦克风设备编号</TextBlock>
                <TextBox x:Name="InputDeviceTextBox" Grid.Column="1" Margin="0,0,0,12" />
            </Grid>
            <CheckBox x:Name="AutoSendCheckBox" Content="识别后自动粘贴并发送" Margin="0,0,0,8" />
            <CheckBox x:Name="RestoreClipboardCheckBox" Content="发送后恢复原剪贴板内容（关闭可保留识别文字）" Margin="0,0,0,8" />
            <TextBlock Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,12">
                默认使用本地 SenseVoiceSmall。选择云端或本地失败回退时，录音会发送到配置的服务；云端 API Key 使用 Windows Credential Manager 保存。
            </TextBlock>
        </StackPanel>
        <StackPanel Grid.Row="13" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0" Click="CancelClick">取消</Button>
            <Button Width="90" Click="SaveClick">保存</Button>
        </StackPanel>
    </Grid>
</Window>
