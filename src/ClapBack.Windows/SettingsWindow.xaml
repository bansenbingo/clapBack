<Window x:Class="ClapBack.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClapBack 设置"
        Width="520"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">识别服务 URL</TextBlock>
        <TextBox x:Name="BaseUrlTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">API Key</TextBlock>
        <PasswordBox x:Name="ApiKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">模型</TextBlock>
        <TextBox x:Name="ModelTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">语言</TextBlock>
        <TextBox x:Name="LanguageTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">最长录音（秒）</TextBlock>
        <TextBox x:Name="MaxSecondsTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">全局热键</TextBlock>
        <TextBox x:Name="HotkeyTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center">麦克风设备编号</TextBlock>
        <TextBox x:Name="InputDeviceTextBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,12">
            当前热键在配置文件中默认为 F13。请在守望先锋前台时按热键开始录音，再按一次完成识别并发送。
        </TextBlock>
        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0" Click="CancelClick">取消</Button>
            <Button Width="90" Click="SaveClick">保存</Button>
        </StackPanel>
    </Grid>
</Window>
