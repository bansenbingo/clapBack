<Window x:Class="ClapBack.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClapBack 设置与字库" Width="750" Height="740" MinWidth="620" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="#EFF4F9" Foreground="#172E48"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,0,8"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TabControl x:Name="SettingsTabs" Background="White" BorderBrush="#CCD9E6">
            <TabItem Header="录音与游戏">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <TextBlock Text="麦克风"/><DockPanel>
                        <Button DockPanel.Dock="Right" Content="刷新" Click="RefreshDevicesClick" Margin="8,0,0,14"/>
                        <ComboBox x:Name="MicrophoneComboBox" DisplayMemberPath="Name"/>
                    </DockPanel>
                    <TextBlock Text="全局热键"/><TextBox x:Name="HotkeyTextBox"/>
                    <TextBlock Text="支持 CapsLock、F1–F24 或 Ctrl+Shift+Space 等组合；请避开游戏常用按键。" Foreground="#506880"/>
                    <TextBlock Text="最长录音（1–300 秒，到时自动识别）" Margin="0,10,0,6"/><TextBox x:Name="MaxSecondsTextBox"/>
                    <TextBlock Text="识别语言"/><TextBox x:Name="LanguageTextBox"/>
                    <CheckBox x:Name="AutoSendCheckBox" Content="识别后自动打开游戏聊天、粘贴并发送"/>
                    <TextBlock Text="默认只复制文字，你在聊天框按 Ctrl+V。开启自动发送时，用全局热键在游戏中录音。" Foreground="#506880"/>
                    <TextBlock Text="自动发送的目标进程（逗号分隔）" Margin="0,10,0,6"/><TextBox x:Name="TargetProcessesTextBox"/>
                    <TextBlock Text="打开聊天的按键"/><ComboBox x:Name="ChatKeyComboBox"><ComboBoxItem Content="Enter"/><ComboBoxItem Content="F2"/></ComboBox>
                    <CheckBox x:Name="RestoreClipboardCheckBox" Content="自动发送后恢复发送前的剪贴板" IsEnabled="False" Visibility="Collapsed"/>
                    <CheckBox x:Name="TranscriptNotificationCheckBox" Content="在通知气泡中显示识别文字"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="识别与下载">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <TextBlock Text="识别模式"/><ComboBox x:Name="TranscriptionModeComboBox">
                        <ComboBoxItem Content="本地优先（失败时上传云端）"/><ComboBoxItem Content="仅本地（不上传音频）"/><ComboBoxItem Content="仅云端（上传音频）"/>
                    </ComboBox>
                    <TextBlock Text="本地模型"/><ComboBox x:Name="LocalModelVariantComboBox" DisplayMemberPath="DisplayName" SelectionChanged="ModelChanged"/>
                    <CheckBox x:Name="AutoProvisionCheckBox" Content="启动及设置变更后自动准备缺失组件"/>
                    <TextBlock Text="本地运行时路径（相对程序目录）"/><TextBox x:Name="LocalRuntimeTextBox"/>
                    <TextBlock Text="模型路径（相对程序目录）"/><TextBox x:Name="LocalModelTextBox"/>
                    <TextBlock Text="VAD 路径（短语音可不安装）"/><TextBox x:Name="LocalVadModelTextBox"/>
                    <CheckBox x:Name="InstallVadCheckBox" Content="准备环境时安装可选 VAD 模型"/>
                    <TextBlock Text="推理后端"/><ComboBox x:Name="LocalBackendComboBox"><ComboBoxItem Content="CPU" Tag="cpu"/><ComboBoxItem Content="Vulkan" Tag="vulkan"/><ComboBoxItem Content="CUDA" Tag="cuda"/></ComboBox>
                    <TextBlock Text="线程数（1–64）"/><TextBox x:Name="LocalThreadsTextBox"/>
                    <TextBlock Text="识别超时（1–300 秒）"/><TextBox x:Name="LocalTimeoutTextBox"/>
                    <Expander Header="下载端点（网络不可用时调整）"><StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Hugging Face 兼容端点（留空用默认镜像）"/><TextBox x:Name="HuggingFaceEndpointTextBox"/>
                        <TextBlock Text="运行时下载端点（留空用 GitHub）"/><TextBox x:Name="RuntimeEndpointTextBox"/>
                    </StackPanel></Expander>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="云端">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <TextBlock Text="只有选择仅云端或本地优先时才会上传录音。服务需支持 Whisper 兼容转写接口。" Foreground="#506880" Margin="0,0,0,20"/>
                    <TextBlock Text="服务 URL（以 /v1 结尾）"/><TextBox x:Name="BaseUrlTextBox"/>
                    <TextBlock Text="模型名称"/><TextBox x:Name="ModelTextBox"/>
                    <TextBlock Text="API Key（保存在 Windows 凭据管理器）"/>
                    <PasswordBox x:Name="ApiKeyBox" Padding="8,6" Margin="0,0,0,14"/>
                    <TextBlock Text="已有密钥加载后可直接保存；清空输入会删除密钥。" Foreground="#506880"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="字库">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <CheckBox x:Name="HomophoneCheckBox" Content="识别后应用同音替换"/>
                    <TextBlock Grid.Row="1" Text="每行一条规则；候选用逗号分隔。结果会随机选择一个候选，再复制或发送。" Foreground="#506880"/>
                    <DataGrid x:Name="DictionaryGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" Margin="0,8,0,12" HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="原词" Binding="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                            <DataGridTextColumn Header="替换候选（逗号分隔）" Binding="{Binding Alternatives, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal"><Button Content="删除选中规则" Click="DeleteEntryClick"/><Button Content="恢复默认字库" Click="ResetDictionaryClick"/></StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="ErrorText" Grid.Row="1" Foreground="#A33C2C" Margin="0,12,0,8"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Click="CancelClick"/>
            <Button x:Name="SaveButton" Content="保存并应用" Click="SaveClick" Background="#2466AC" Foreground="White" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
