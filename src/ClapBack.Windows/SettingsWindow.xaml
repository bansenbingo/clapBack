<Window x:Class="ClapBack.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClapBack 设置与字库" Width="750" Height="760" MinWidth="620" MinHeight="580"
        Icon="pack://application:,,,/Assets/ClapBack.ico"
        WindowStartupLocation="CenterOwner" Background="#EFF4F9" Foreground="#172E48"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,0,8"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TabControl x:Name="SettingsTabs" Background="White" BorderBrush="#CCD9E6">
            <TabItem Header="录音与游戏">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <TextBlock Text="麦克风"/><DockPanel>
                        <Button DockPanel.Dock="Right" Content="刷新" Click="RefreshDevicesClick" Margin="8,0,0,14"
                                ToolTip="重新枚举本机麦克风。"/>
                        <ComboBox x:Name="MicrophoneComboBox" DisplayMemberPath="Name"
                                  ToolTip="选择录音用的麦克风。插拔设备后点“刷新”重新枚举。"/>
                    </DockPanel>
                    <TextBlock Text="热键设置"/>
                    <TextBox x:Name="HotkeyTextBox" TextAlignment="Center" FontWeight="Bold"
                             PreviewKeyDown="HotkeyBoxPreviewKeyDown" PreviewKeyUp="HotkeyBoxPreviewKeyUp"
                             GotKeyboardFocus="HotkeyBoxGotKeyboardFocus" LostKeyboardFocus="HotkeyBoxLostKeyboardFocus"
                             ToolTip="两种方式都行：直接按 Ctrl/Alt/Shift/Win 组合键自动捕获，或手动输入按键名，例如 CapsLock、Enter、Space、F8、Ctrl+Shift+Space。字母和数字要配合 Ctrl/Alt/Shift/Win；新热键注册失败会保留原热键。"/>
                    <TextBlock x:Name="HotkeyHintText" Text="" Visibility="Collapsed" Foreground="#506880"/>
                    <TextBlock Text="最长录音" Margin="0,10,0,6"/>
                    <TextBox x:Name="MaxSecondsTextBox" ToolTip="1–300 秒。到时自动停止录音并开始识别。"/>
                    <TextBlock Text="识别语言"/>
                    <ComboBox x:Name="LanguageComboBox" ToolTip="识别使用的语言；选“自动检测”由模型自行判断。"/>
                    <CheckBox x:Name="AutoSendCheckBox" Content="识别后自动打开游戏聊天、粘贴并发送"
                               ToolTip="默认只复制文字，你在聊天框按 Ctrl+V。开启后固定按三步走：打开聊天 → Ctrl+V 粘贴 → Enter 发送；这时请用全局热键在游戏中录音。"/>
                    <TextBlock Text="自动发送的目标进程" Margin="0,10,0,6"/>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="刷新列表" Click="RefreshProcessesClick" Margin="8,0,0,0"
                                ToolTip="重新枚举本机当前有窗口的进程。"/>
                        <ComboBox x:Name="TargetProcessComboBox"
                                  ToolTip="列表来自本机当前有窗口的进程，先列出 Overwatch / Overwatch2。"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="添加所选进程" Click="AddTargetProcessClick"
                                ToolTip="把下拉里选中的进程加入白名单。"/>
                        <Button Content="清空" Click="ClearTargetProcessesClick"
                                ToolTip="清空白名单；开启自动发送前需要重新填写。"/>
                    </StackPanel>
                    <TextBlock Text="进程白名单"/>
                    <TextBox x:Name="TargetProcessesTextBox"
                             ToolTip="逗号分隔，可直接编辑。只有这里列出的进程才会被自动发送。"/>
                    <TextBlock Text="呼出聊天的按键"/>
                    <TextBox x:Name="ChatOpenKeyTextBox" LostFocus="ChatKeyBoxLostFocus"
                             ToolTip="填一个键的名字，例如 T 或 Enter。识别后先按它打开游戏聊天框。"/>
                    <TextBlock Text="确认发送的按键"/>
                    <TextBox x:Name="SendKeyTextBox" LostFocus="ChatKeyBoxLostFocus"
                             ToolTip="填一个键的名字，例如 Enter。粘贴完成后按它把消息发出去，任意单键都可以。"/>
                    <CheckBox x:Name="RestoreClipboardCheckBox" Content="自动发送后恢复发送前的剪贴板" IsEnabled="False" Visibility="Collapsed"/>
                    <CheckBox x:Name="TranscriptNotificationCheckBox" Content="在通知气泡中显示识别文字"
                              ToolTip="识别完成后在右下角通知气泡里显示识别文字。"/>
                    <CheckBox x:Name="MinimizeToTrayCheckBox" Content="最小化时收起到托盘运行"
                              ToolTip="开启后最小化会收起到托盘运行。"/>
                    <CheckBox x:Name="RunAsAdministratorCheckBox" Content="启动时以管理员身份运行"
                              ToolTip="启动时会弹 UAC 提权框；点“否”则以普通权限继续运行。"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="识别与下载">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <TextBlock Text="识别模式"/>
                    <ComboBox x:Name="TranscriptionModeComboBox"
                              ToolTip="仅本地不会上传音频；本地优先只在本地识别失败时上传；仅云端总是上传。云端服务需支持 Whisper 兼容转写接口。">
                        <ComboBoxItem Content="本地优先"/><ComboBoxItem Content="仅本地"/><ComboBoxItem Content="仅云端"/>
                    </ComboBox>
                    <CheckBox x:Name="TrimTrailingPunctuationCheckBox" Content="去掉识别结果句末的句号"
                              ToolTip="模型常补一个句号，粘进游戏聊天框反而碍事；问号、感叹号保留。"/>
                    <TextBlock Text="本地模型"/>
                    <ComboBox x:Name="LocalModelVariantComboBox" DisplayMemberPath="DisplayName" SelectionChanged="ModelChanged"
                              ToolTip="选择要下载并使用的本地识别模型。"/>
                    <CheckBox x:Name="AutoProvisionCheckBox" Content="启动及设置变更后自动准备缺失组件"
                              ToolTip="启动及设置变更后自动下载缺失的运行时、模型和 VAD。"/>
                    <TextBlock Text="本地运行时路径"/>
                    <TextBox x:Name="LocalRuntimeTextBox" ToolTip="相对 exe 所在目录。"/>
                    <TextBlock Text="模型路径"/>
                    <TextBox x:Name="LocalModelTextBox" ToolTip="相对 exe 所在目录。"/>
                    <TextBlock Text="VAD 路径"/>
                    <TextBox x:Name="LocalVadModelTextBox" ToolTip="相对 exe 所在目录；短语音可以不安装。"/>
                    <CheckBox x:Name="InstallVadCheckBox" Content="准备环境时安装可选 VAD 模型"
                              ToolTip="VAD 用于切分长语音，属于可选组件。"/>
                    <TextBlock Text="推理后端"/>
                    <ComboBox x:Name="LocalBackendComboBox" ToolTip="CPU 最稳；Vulkan / CUDA 需要匹配的显卡驱动。">
                        <ComboBoxItem Content="CPU" Tag="cpu"/><ComboBoxItem Content="Vulkan" Tag="vulkan"/><ComboBoxItem Content="CUDA" Tag="cuda"/>
                    </ComboBox>
                    <TextBlock Text="线程数"/>
                    <TextBox x:Name="LocalThreadsTextBox" ToolTip="1–64。"/>
                    <TextBlock Text="识别超时"/>
                    <TextBox x:Name="LocalTimeoutTextBox" ToolTip="1–300 秒，超过就放弃本次本地识别。"/>
                    <Expander Header="下载端点" ToolTip="下载失败时在这里改用镜像或自己的端点。">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Hugging Face 兼容端点"/>
                            <TextBox x:Name="HuggingFaceEndpointTextBox" ToolTip="留空用默认镜像。"/>
                            <TextBlock Text="运行时下载端点"/>
                            <TextBox x:Name="RuntimeEndpointTextBox" ToolTip="留空用 GitHub。"/>
                        </StackPanel>
                    </Expander>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="云端">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <TextBlock Text="服务 URL"/>
                    <TextBox x:Name="BaseUrlTextBox" ToolTip="以 /v1 结尾，例如 https://api.openai.com/v1。"/>
                    <TextBlock Text="模型名称"/>
                    <ComboBox x:Name="ModelComboBox" IsEditable="True"
                              ToolTip="可从常用名称里选，也可以直接输入。"/>
                    <TextBlock Text="API Key"/>
                    <PasswordBox x:Name="ApiKeyBox" Padding="8,6" Margin="0,0,0,14"
                                 ToolTip="保存在 Windows 凭据管理器。加载已有密钥后可直接保存；清空输入会删除密钥。"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="游戏气泡">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <CheckBox x:Name="ShowOverlayCheckBox" Content="识别时在游戏画面上显示字符气泡"
                              ToolTip="气泡是一个置顶、半透明的小窗，只显示识别结果，不会抢走游戏的键盘焦点。"/>
                    <TextBlock Text="字号" Margin="0,10,0,6"/>
                    <TextBox x:Name="OverlayFontSizeTextBox" ToolTip="12–72。"/>
                    <TextBlock Text="不透明度" Margin="0,10,0,6"/>
                    <TextBox x:Name="OverlayOpacityTextBox" ToolTip="0.2–1.0。"/>
                    <TextBlock Text="显示时长" Margin="0,10,0,6"/>
                    <TextBox x:Name="OverlayDurationTextBox" ToolTip="1–60 秒。"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="预览气泡" Click="PreviewOverlayClick"
                                ToolTip="先看一眼气泡的样子，再决定字号和透明度。"/>
                        <Button Content="气泡位置复位" Click="ResetOverlayPositionClick"
                                ToolTip="回到屏幕底部居中。平时直接把气泡拖到想要的位置即可，位置会自动记住。"/>
                    </StackPanel>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="字库">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <CheckBox x:Name="HomophoneCheckBox" Content="识别后应用同音替换"
                              ToolTip="识别后按字库做同音替换；预览、剪贴板和发送使用同一份文本。"/>
                    <DataGrid x:Name="DictionaryGrid" Grid.Row="1" Grid.RowSpan="2" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" Margin="0,8,0,12" HeadersVisibility="Column" SelectionMode="Single"
                              ToolTip="每行一条规则；候选用逗号分隔。结果会随机选择一个候选，再复制或发送。">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="原词" Binding="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                            <DataGridTextColumn Header="替换候选" Binding="{Binding Alternatives, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button Content="删除选中规则" Click="DeleteEntryClick" ToolTip="删除当前选中的规则行。"/>
                        <Button Content="恢复默认字库" Click="ResetDictionaryClick" ToolTip="恢复内置的默认字库规则。"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="ErrorText" Grid.Row="1" Foreground="#A33C2C" Margin="0,12,0,8"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Click="CancelClick"/>
            <Button x:Name="SaveButton" Content="保存并应用" Click="SaveClick" Background="#2466AC" Foreground="White" Margin="0"
                    ToolTip="保存并应用设置；热键注册失败时会保留原热键。"/>
        </StackPanel>
    </Grid>
</Window>
