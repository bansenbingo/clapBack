<Window x:Class="ClapBack.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClapBack 气泡"
        Icon="pack://application:,,,/Assets/ClapBack.ico"
        Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual" Focusable="False"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <!--
      游戏内字符气泡：无边框、半透明、置顶、不抢焦点。
      视觉沿用主窗口的深蓝墨色 + 强调蓝描边，保证在亮色和暗色游戏画面上都能看清。
    -->
    <Border x:Name="Bubble"
            CornerRadius="14" Padding="22,14"
            Background="#F0101E30" BorderBrush="#B02E6BAA" BorderThickness="1.6"
            Cursor="SizeAll">
        <TextBlock x:Name="BubbleText"
                   Foreground="#F4F8FC" TextWrapping="Wrap" TextAlignment="Center"/>
    </Border>
</Window>
