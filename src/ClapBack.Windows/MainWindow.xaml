<Window x:Class="ClapBack.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClapBack" Width="790" Height="660" MinWidth="620" MinHeight="550"
        Icon="pack://application:,,,/Assets/ClapBack.ico"
        Background="#EFF4F9" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="#172E48"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CCD9E6"/>
            <Setter Property="Foreground" Value="#172E48"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </Window.Resources>
    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="SettingsButton" Click="SettingsClick" Content="设置与字库"/>
                <Button Click="HideClick" Content="收起到托盘" Margin="0"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="ClapBack" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="说完，粘贴，回到游戏。" Foreground="#506880" Margin="0,5,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="#DBE9F6" Padding="20,16" CornerRadius="10" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock x:Name="StateText" Text="正在启动" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HotkeyText" Margin="0,7,0,0" Foreground="#345573"/>
                    <TextBlock x:Name="RecordingTimeText" Margin="0,5,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="RecordButton" Click="RecordClick" Content="开始录音" FontSize="17" FontWeight="SemiBold"
                            Padding="25,15" Background="#2466AC" Foreground="White" BorderThickness="0" Margin="0"/>
                    <Button x:Name="CancelButton" Click="CancelClick" Content="取消本次语音" Visibility="Collapsed" Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="CopyButton" DockPanel.Dock="Right" Click="CopyClick" Content="复制文字" IsEnabled="False" Margin="0"
                        ToolTip="把识别结果再复制一次到剪贴板。"/>
                <TextBlock Text="识别结果" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox x:Name="TranscriptBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="White" BorderBrush="#CCD9E6" Padding="16"
                     FontSize="20" MinHeight="80"
                     ToolTip="识别结果会显示在这里，并自动复制到剪贴板。"/>
            <TextBlock x:Name="MessageText" Grid.Row="2" Text=""
                       Foreground="#506880" Margin="0,9,0,0"/>
        </Grid>
        <Expander Grid.Row="3" Header="识别环境与准备进度" IsExpanded="True" Margin="0,0,0,14"
                  ToolTip="本地识别运行时、模型与 VAD 的就绪情况；缺失的组件会按设置自动下载。">
            <DockPanel Margin="0,10,0,0">
                <Button x:Name="PrepareButton" DockPanel.Dock="Right" Click="PrepareClick" Content="重新检测" Margin="12,0,0,0" VerticalAlignment="Top"
                        ToolTip="重新检查本地识别组件是否就绪。"/>
                <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="EnvironmentText" Text="正在检查所需组件…" Foreground="#506880"/>
                </ScrollViewer>
            </DockPanel>
        </Expander>
        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Right" Click="ExitClick" Content="退出程序" Margin="0" Padding="12,6"/>
            <TextBlock x:Name="ModeText" Text="" Foreground="#506880" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
